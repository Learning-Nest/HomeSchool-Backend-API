# Copy to .env.local (git-ignored) for running the API natively against the docker-compose database.
# These two values are for the local container only. Never reuse them anywhere else.
DB_PASSWORD=local-dev-only-app-password
JWT_SECRET=local-dev-only-jwt-secret-not-for-deployment

# To send real email from your laptop (forgot-password, "Email me a code"), uncomment and fill in.
# Use a Google app password (never the account password). Without this the API only prints emails in its log.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=verification@learnnests.org
# SMTP_PASSWORD=
# EMAIL_FROM=LearnNest <verification@learnnests.org>
