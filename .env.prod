# Production on Azure. Committed on purpose: contains NO secrets.
# JWT_SECRET, DB_PASSWORD, SMTP_PASSWORD, OTP_WEBHOOK_TOKEN (or MSG91_AUTH_KEY, if OTP_PROVIDER=msg91) come from Key Vault;
# DB_HOST, CORS_ORIGINS, OTP_WEBHOOK_URL and SMTP_HOST / EMAIL_FROM are set by Terraform.
APP_ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true

# CORS_ORIGINS=<set by Terraform: production admin console and site origins, never *>
TRUSTED_HOSTS=*

DB_PORT=5432
DB_NAME=homeschool
DB_USER=homeschool_app
DB_SSLMODE=require

# Real SMS delivery is required in production (the config validator refuses the console provider).
# Switch to msg91 (and set MSG91_AUTH_KEY + MSG91_TEMPLATE_ID in Key Vault) once TRAI DLT registration and
# the MSG91 template are approved - see the "Register for TRAI DLT" task.
OTP_PROVIDER=webhook

# Transactional email (guardian email codes, forgot-password). The config validator refuses the console provider here.
# Also set SMTP_HOST and EMAIL_FROM (non-secret) and SMTP_USERNAME / SMTP_PASSWORD (Key Vault) in the environment.
EMAIL_PROVIDER=smtp
SMTP_PORT=587
SMTP_SECURITY=starttls
EXPOSE_DEV_OTP=false
DECLARATION_NOTICE_VERSION=2026-09-draft

MIN_APP_VERSION=0.1.0
ENABLE_RECOMMENDATIONS=true
SEED_ON_STARTUP=false
